    <!-- Password handling. The warning below is shown in the editor, not
         buried in a comment: a remembered password really is readable by
         anything that can read this app\'s private data. -->
    <string name="db_remember_password">Remember password</string>
    <string name="db_remember_password_warning">Off: you are asked for the password each time you connect, and nothing is written to disk. On: the password is stored unencrypted in this app\'s settings on this device — anyone who can read the app\'s data can read the password.</string>
    <string name="db_password_prompt_title">Password</string>
    <string name="db_password_prompt_message">“%1$s” does not remember its password. Enter it to connect; it is kept in memory for this session only.</string>

    <!-- SSL. Both bundled drivers verify TLS host names through
         javax.naming.ldap.LdapName, which Android does not ship. -->
    <string name="db_field_ssl">Use SSL/TLS (unreliable on Android)</string>
    <string name="db_ssl_warning">Android does not ship javax.naming.ldap, which both drivers use for TLS host name verification. With SSL on, the connection is encrypted but the server certificate is NOT verified, and some servers still fail with a linkage error. For a trustworthy encrypted link, tunnel the plain connection over SSH or a VPN instead.</string>

