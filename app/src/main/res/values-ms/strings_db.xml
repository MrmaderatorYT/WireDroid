    <string name="db_remember_password">Ingat kata laluan</string>
    <string name="db_remember_password_warning">Mati: kata laluan diminta setiap kali anda menyambung, dan tiada apa yang ditulis ke cakera. Hidup: kata laluan disimpan tanpa penyulitan dalam tetapan aplikasi ini pada peranti ini — sesiapa yang boleh membaca data aplikasi boleh membaca kata laluan itu.</string>
    <string name="db_password_prompt_title">Kata laluan</string>
