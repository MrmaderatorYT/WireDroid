<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="ai_key_button">விசை</string>
    <string name="ai_ready">AI உதவியாளர் தயார். Java பற்றிக் கேளுங்கள், குறியீட்டை விளக்கச் சொல்லுங்கள், பிழைகளைக் கண்டறியுங்கள், மறுசீரமையுங்கள், உகந்ததாக்குங்கள் அல்லது சோதனைகளை உருவாக்குங்கள்.</string>
    <string name="ai_loaded_file">%1$s ஏற்றப்பட்டது (%2$d எழுத்துகள்). இந்தக் குறியீடு பற்றி எதையும் கேளுங்கள்.</string>
    <string name="ai_loaded_file_short">%1$s ஏற்றப்பட்டது (%2$d எழுத்துகள்).</string>
    <string name="ai_key_not_set">இன்னும் API விசை இல்லை. aistudio.google.com இலிருந்து உங்கள் Gemini விசையைச் சேர்க்க “விசை” என்பதைத் தட்டவும்</string>
    <string name="ai_key_needed_first">முதலில் உங்கள் API விசையைச் சேர்க்கவும் — “விசை” என்பதைத் தட்டவும்.</string>
    <string name="ai_model_changed">மாதிரி %1$s ஆக மாற்றப்பட்டது</string>
    <string name="ai_key_saved_checking">விசை சேமிக்கப்பட்டது. Google உடன் சரிபார்க்கப்படுகிறது…</string>
    <string name="ai_key_verified">விசை சரிபார்க்கப்பட்டது. மாதிரி: %1$s</string>
    <string name="ai_key_saved_unverified">விசை சேமிக்கப்பட்டது, ஆனால் சரிபார்ப்பு வெற்றிபெறவில்லை:\n%1$s</string>
    <string name="ai_key_save_failed_title">விசையைச் சேமிக்க முடியவில்லை</string>
    <string name="ai_key_save_failed_message">இந்தச் சாதனத்தின் பாதுகாப்பான சேமிப்பு அதை மறுத்தது, எனவே விசை வைக்கப்படவில்லை. மறையாக்கம் இல்லாமல் சேமிப்பது வேண்டுமென்றே தவிர்க்கப்படுகிறது.</string>
    <string name="ai_key_check_title">இந்த விசையைச் சரிபார்</string>
    <string name="ai_key_save_anyway">எப்படியும் சேமி</string>
    <string name="ai_key_save_verify">சேமித்துச் சரிபார்</string>
    <string name="ai_key_get">விசை பெறு</string>
    <string name="ai_insert_into_editor">↧ திருத்தியில் சேர்</string>
    <string name="ai_insert_desc">இந்தக் குறியீட்டைத் திறந்துள்ள திருத்தியில் சேர்</string>
    <string name="ai_queued">வரிசையில் உள்ளது (%1$s) — பயன்படுத்த திருத்திக்குத் திரும்பவும்</string>
</resources>
