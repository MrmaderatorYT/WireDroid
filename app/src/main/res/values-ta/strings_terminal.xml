    <string name="terminal_welcome">"Android க்கான JShell க்கு வரவேற்கிறோம்.\nJava கூற்றுகளை உள்ளிடவும் (எ.கா. System.out.println(\"Hi\");)\n\n"</string>
    <string name="terminal_prompt_echo">"jshell> %1$s\n"</string>
    <string name="terminal_help">"கிடைக்கும் கட்டளைகள்:\n  /help    - இந்த உதவிச் செய்தியைக் காட்டு\n  /clear   - கன்சோல் வெளியீட்டை அழி\n  /reset   - JShell நினைவகத்தை மீட்டமை (மாறிகளை மறக்கச் செய்)\n  /history - உள்ளிட்ட கட்டளைகளின் வரலாற்றைக் காட்டு\n\n"</string>
    <string name="terminal_cleared">"கன்சோல் அழிக்கப்பட்டது.\n\n"</string>
    <string name="terminal_reset_done">"JShell நிலை மீட்டமைக்கப்பட்டது. அனைத்து மாறிகளும் மறக்கப்பட்டன.\n\n"</string>
    <string name="terminal_history_empty">"வரலாறு காலியாக உள்ளது.\n\n"</string>
    <string name="terminal_history_header">"வரலாறு:\n"</string>
