<resources>
    <string name="gh_import_title">களஞ்சியத்தை இறக்குமதி செய்</string>
    <string name="gh_import_message">GitHub, GitLab அல்லது Bitbucket இலிருந்து களஞ்சிய இணைப்பை ஒட்டவும். ஒரு கிளைக்கான அல்லது கோப்புக்கான இணைப்பும் வேலை செய்யும் — கிளை தக்கவைக்கப்படும்.</string>
    <string name="gh_url_hint">களஞ்சிய URL, அல்லது user/repo</string>
    <string name="gh_name_hint">திட்டக் கோப்புறையின் பெயர் (விருப்பத்தேர்வு)</string>
    <string name="gh_user_hint">பயனர் பெயர் (விருப்பத்தேர்வு, தனிப்பட்ட களஞ்சியங்களுக்கு)</string>
    <string name="gh_token_hint">டோக்கன் / கடவுச்சொல் (விருப்பத்தேர்வு)</string>
    <string name="gh_import_button">இறக்குமதி செய்</string>
    <string name="gh_url_required">களஞ்சிய URL ஐ உள்ளிடவும்</string>
    <string name="gh_invalid_url_title">இது களஞ்சிய URL அல்ல</string>
    <string name="gh_invalid_url_message">இது களஞ்சியம் போலத் தெரியவில்லை. இவற்றில் எதுவும் வேலை செய்யும்:\n\nhttps://github.com/user/repo\nhttps://github.com/user/repo.git\nhttps://github.com/user/repo/tree/dev\nhttps://github.com/user/repo/blob/main/src/Foo.java\ngit@github.com:user/repo.git\nuser/repo\n\nGitLab மற்றும் Bitbucket URL களும் இதே போலவே வேலை செய்கின்றன.</string>
    <string name="gh_folder_exists">\"%1$s\" கோப்புறை ஏற்கெனவே உள்ளது, அது காலியாகவும் இல்லை. வேறு பெயரைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="gh_progress_title">%1$s இறக்குமதி செய்யப்படுகிறது</string>
