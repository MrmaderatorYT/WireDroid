<?xml version="1.0" encoding="utf-8"?>
<!--
    Split out of activity_main so it can sit behind a ViewStub: this panel
    starts hidden and most sessions never open it, but it was still inflated
    on every cold start along with every other bottom panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profilerPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/idea_console_bg"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/profilerToolbar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/idea_toolbar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/profilerRefresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="↻"
            android:textColor="@color/idea_accent"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="+"
            android:textColor="@color/idea_text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="−"
            android:textColor="@color/idea_text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerFit"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Fit"
            android:textColor="@color/idea_text"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/idea_separator" />

        <TextView
            android:id="@+id/profilerRunBtn"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="▶ Run"
            android:textColor="@color/idea_accent"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerLiveToggle"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="● Live"
            android:textColor="#499C54"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerMetrics"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Metrics"
            android:textColor="@color/idea_text"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/profilerSnapshot"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Snapshot"
            android:textColor="@color/idea_text"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/profilerStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:text=""
            android:textColor="@color/idea_text_dim"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <com.ccs.wiredroid.ui.FlameChartView
        android:id="@+id/flameChartView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:id="@+id/profilerDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/idea_console_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/profilerDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@color/idea_console_text"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.2"
            android:textIsSelectable="true" />
    </ScrollView>

</LinearLayout>
