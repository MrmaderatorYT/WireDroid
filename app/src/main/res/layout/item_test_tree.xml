<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Row header -->
    <LinearLayout
        android:id="@+id/testRowHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <View
            android:id="@+id/testIndentView"
            android:layout_width="0dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/testExpandIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_back"
            android:rotation="180"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/testStatusIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_test_pass" />

        <TextView
            android:id="@+id/testTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/idea_text"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/testDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/idea_text_dim"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Error info box (shown for failed tests) -->
    <LinearLayout
        android:id="@+id/testErrorBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:padding="6dp"
        android:background="#1AE53935"
        android:visibility="gone">

        <TextView
            android:id="@+id/testErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#EF5350"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/testJumpLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4FC3F7"
            android:text="@string/test_runner_jump_to_source" />

    </LinearLayout>

</LinearLayout>
