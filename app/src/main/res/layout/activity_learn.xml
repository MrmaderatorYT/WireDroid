<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/learnRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/idea_bg">

    <!-- Toolbar: section spinner + language toggle -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/learnToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/idea_toolbar"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerCourse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/a11y_learn_course_selector" />

            <TextView
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="UK"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/idea_accent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/a11y_learn_language_toggle" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <View
        android:id="@+id/learnToolbarSep"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/idea_separator" />

    <!-- Section description container -->
    <LinearLayout
        android:id="@+id/courseDescContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/idea_console_bg">

        <TextView
            android:id="@+id/tvCourseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/idea_text_dim" />

        <View
            android:id="@+id/courseDescDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/idea_separator" />
    </LinearLayout>

    <!-- Chapters List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChapters"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:background="@color/idea_bg" />

</LinearLayout>
