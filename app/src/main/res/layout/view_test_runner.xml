<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/testRunnerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/idea_console_bg">

    <!-- Summary Toolbar -->
    <LinearLayout
        android:id="@+id/testSummaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/idea_toolbar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/testSummaryIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_test_pass"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/testSummaryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/idea_text"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Filter: All / Failed -->
        <TextView
            android:id="@+id/btnTestFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/idea_accent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnTestFilterFailed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/idea_text_dim"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Toggle Console button -->
        <TextView
            android:id="@+id/btnToggleConsole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_runner_tab_console"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/idea_text"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Empty view if no tests -->
    <TextView
        android:id="@+id/testEmptyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/test_runner_no_tests"
        android:textColor="@color/idea_text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Test tree recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/testRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

</LinearLayout>
