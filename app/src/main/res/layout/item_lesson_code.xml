<?xml version="1.0" encoding="utf-8"?>
<!-- CODE + Jupyter-подібний inline output -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blockCodeContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/blockCodeToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/blockCodeLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Java 8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/blockCodePlayground"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open in Playground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚡ Playground"
            android:textSize="12sp"
            android:textColor="@color/idea_accent" />

        <TextView
            android:id="@+id/blockCodeRun"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lesson_run_example"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/lesson_run"
            android:textSize="12sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/blockCodeScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="horizontal">

        <TextView
            android:id="@+id/blockCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.15"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/blockCodeConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/blockCodeOutputLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lesson_output"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/blockCodeClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lesson_clear_output"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/lesson_clear"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/blockCodeClose"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lesson_hide_output"
                android:gravity="center"
                android:text="✕"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/blockCodeOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.15"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
