<?xml version="1.0" encoding="utf-8"?>
<!--
    Split out of activity_main so it can sit behind a ViewStub: this panel
    starts hidden and most sessions never open it, but it was still inflated
    on every cold start along with every other bottom panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callGraphRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/idea_console_bg"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/callGraphToolbar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/idea_toolbar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/callGraphSearch"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:hint="Search method..."
            android:contentDescription="@string/a11y_callgraph_search"
            android:textColorHint="@color/idea_text_dim"
            android:textColor="@color/idea_console_text"
            android:textSize="11sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/callGraphRefresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="↻"
            android:textColor="@color/idea_accent"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/a11y_call_graph_refresh" />

    </LinearLayout>

    <TextView
        android:id="@+id/callGraphStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="10sp"
        android:textColor="@color/idea_text_dim"
        android:fontFamily="monospace"
        android:background="@color/idea_console_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/callGraphContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp" />

    </ScrollView>

</LinearLayout>
