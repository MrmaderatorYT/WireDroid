.cxx/
build/
app/build/
**/build/
**/.cxx/
.aider*
/app/release/app-release.apk
/app/release/output-metadata.json
/tools/i18n.py
/fix_strings.py
.bug-hunter/
*.zip
/AssemblyDroid/
__pycache__/
*.pyc
.DS_Store
**/.DS_Store
.mimocode/

# Installable binaries are published as GitHub Release assets
/artifacts/*.apk
